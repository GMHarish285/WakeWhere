{
  "expo": {
    "name": "WakeWhere",
    "slug": "wakewhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wakewhere_icon.png",
    "scheme": "wakewhere",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harishgm.wakewhere",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs your location to track your destination.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app tracks your location even when the app is in the background.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.harishgm.wakewhere"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "./plugins/withAlarmServiceFile.js",
      "./plugins/withAlarmPackageFile.js",
      "./plugins/withAlarmMainApplication.js",
      "./plugins/withAlarmManifest.js",
      "./plugins/withAlarmModuleFile.js",
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "98cee1fb-552c-4240-afd1-764dcb4c6bbd"
      }
    }
  }
}
