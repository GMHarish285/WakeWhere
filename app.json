{
  "expo": {
    "name": "WakeWhere",
    "slug": "wakewhere",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WakeWhere uses your location to track your distance to a destination.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "WakeWhere needs background location access to alert you when you reach your destination."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "98cee1fb-552c-4240-afd1-764dcb4c6bbd"
      }
    }
  }
}
